# Chave da API: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo (padrão claude-opus-5-5). Para custo mínimo: claude-haiku-5-5
# MODELO=claude-opus-5-5

# Esforço de raciocínio: low | medium | high (padrão low = mais barato e rápido)
# ESFORCO=low

# PORT=3000

# Pasta onde ficam usuários e segredo da sessão (padrão ./data)
# DADOS=./data

# Segredo para assinar os logins. Se vazio, é gerado e salvo em data/segredo.txt
# SEGREDO_SESSAO=

# Force cookie "Secure" (use 1 quando o site estiver em HTTPS)
# COOKIE_SEGURO=1
